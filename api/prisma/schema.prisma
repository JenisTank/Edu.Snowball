/// Petty-cash ledger per unit. The float itself is a unit setting; this table
/// records every rupee in and out so the balance is always reconstructable.
model PettyCashEntry {
  id           String   @id @default(uuid()) @db.Uuid
  unitId       String   @map("unit_id") @db.Uuid
  date         DateTime @db.Date
  type         String // TOPUP | SPEND | RETURN
  description  String
  amount       Decimal  @db.Decimal(10, 2)
  receiptRef   String?  @map("receipt_ref")
  recordedById String?  @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([unitId, date])
  @@map("petty_cash_entries")
}

// Inward / Outward register (spec module 16) — every non-stock item that enters
// or leaves the premises: courier, documents, keys, repairs.
model InwardOutwardEntry {
  id           String   @id @default(uuid()) @db.Uuid
  unitId       String   @map("unit_id") @db.Uuid
  direction    String // INWARD | OUTWARD
  date         DateTime @db.Date
  category     String // COURIER | DOCUMENT | ASSET | REPAIR | VISITOR | OTHER
  party        String // who sent it or who took it
  description  String
  reference    String?
  handledById  String?  @map("handled_by_id") @db.Uuid
  acknowledged Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([unitId, date])
  @@map("inward_outward_entries")
}

/// A child who attends the evening centre without being enrolled in the
/// preschool (spec: external registration). Kept separate from Student so a
/// non-student never appears in attendance or fee reports.
model EveningParticipant {
  id            String   @id @default(uuid()) @db.Uuid
