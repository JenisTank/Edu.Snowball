  status     String   @default("SCHEDULED") // SCHEDULED | HELD | CANCELLED
  createdAt  DateTime @default(now()) @map("created_at")

  activity   EveningActivity   @relation(fields: [activityId], references: [id])
  attendance EveningAttendance[]

  @@unique([activityId, date])
  @@map("evening_sessions")
}

model EveningAttendance {
  id            String    @id @default(uuid()) @db.Uuid
  sessionId     String    @map("session_id") @db.Uuid
  studentId     String?   @map("student_id") @db.Uuid
  participantId String?   @map("participant_id") @db.Uuid
  status        String    @default("PRESENT") // PRESENT | ABSENT
  markedById    String?   @map("marked_by_id") @db.Uuid
  markedAt      DateTime? @map("marked_at")

  session     EveningSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     Student?             @relation(fields: [studentId], references: [id])
  participant EveningParticipant?  @relation(fields: [participantId], references: [id])

