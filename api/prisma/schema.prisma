  @@unique([sessionId, participantId])
  @@index([sessionId])
  @@map("evening_attendance")
}

/// Parent-bookable PTM slot. One booking per slot keeps the queue honest.
model PtmSlot {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  startTime  DateTime  @map("start_time")
  endTime    DateTime  @map("end_time")
  studentId  String?   @map("student_id") @db.Uuid
  bookedAt   DateTime? @map("booked_at")
  bookedById String?   @map("booked_by_id") @db.Uuid // parent user id or staff user id
  notes      String?

  session PtmSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, startTime])
  @@index([sessionId])
  @@map("ptm_slots")
}

model Employee {
