  createdAt     DateTime @default(now()) @map("created_at")

  enrollments EveningEnrollment[]
  attendance  EveningAttendance[]

  @@index([unitId, active])
  @@map("evening_participants")
}

/// One class occurrence of an evening activity.
model EveningSession {
