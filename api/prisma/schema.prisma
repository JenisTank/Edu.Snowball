// BumbleB Kidz ERP — Prisma Schema v1 (Phase 1 scope)
// Source of truth: BumbleB Kidz ERP Complete Specification, Session 2.1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── ENUMS ───────────────────────────

enum UserRole {
  FOUNDER
  ACADEMIC_DIR
  CURRICULUM_LEAD
  CENTRE_HEAD
  COORDINATOR
  TEACHER
  RECEPTIONIST
  HR_MANAGER
}

enum UnitType {
  COMPANY_OWNED
  FRANCHISE
}

enum UnitStatus {
  ACTIVE
  DEVELOPMENT
  INACTIVE
}

enum LeadStage {
  NEW_INQUIRY
  FIRST_BUZZ
  ROUTING
  EXPERIENCE_SESSION
  DISCOVERY_FLIGHT
  OFFER
  CONFIRMATION
  ENROLLED
  LOST
}

enum InquiryChannel {
  CALL
  WHATSAPP
  WEBSITE
  SOCIAL
  EVENT
  REFERRAL
  WALK_IN
}

enum StudentStatus {
  REGISTERED // Stage-2 registration done, admission not yet confirmed
  ACTIVE
  TC_ISSUED
  GRADUATED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum ScreeningResult {
  EP
  GP
  SP
  NP
  ND
}

enum InstalmentPlan {
  PLAN_A // 3 instalments
  PLAN_B // 2 instalments
  PLAN_C // full payment
}

enum PaymentMode {
  CASH
  CHEQUE
  UPI
  UPI_QR // online UPI collected through the parent app
  POS
  NEFT
}

enum LedgerType {
  PRESCHOOL
  EVENING
}

// ─────────────────────────── FOUNDATION ───────────────────────────

model Unit {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique // U1 | U2 | U3
  name      String
  type      UnitType   @default(COMPANY_OWNED)
  address   String?
  phone     String? // internal ops number only — never advertised
  email     String?
  website   String?
  status    UnitStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")

  settings          UnitSettings?
  users             User[]
  batches           Batch[]
  students          Student[]
  leadsAssigned     Lead[]        @relation("AssignedUnit")
  leadsSuggested    Lead[]        @relation("SuggestedUnit")
  feeStructures     FeeStructure[]
  feeTransactions   FeeTransaction[]
  attendanceRecords AttendanceRecord[]
  studentLeaves    StudentLeave[]
  feeAddons        FeeAddon[]
  discoveryFlights  DiscoveryFlight[]
  areaMappings      AreaMaster[]
  waitlistEntries   WaitlistEntry[]
  onlinePayments    OnlinePayment[]
  securityDeposits  SecurityDeposit[]
  guestLogs         GuestLog[]
  studentDocuments  StudentDocument[]

  @@map("units")
}

model UnitSettings {
  unitId          String  @id @map("unit_id") @db.Uuid
  pettyCashFloat  Decimal @default(5000.00) @map("petty_cash_float") @db.Decimal(10, 2) // HO-edit only
  admissionNumber String? @map("admission_number") // published central hub number only
  phone           String? // front-desk number, shown on letters and the parent app
  // UPI collection: the centre's own VPA. No gateway, no KYC — a QR is built
  // per amount and the front desk confirms the credit.
  upiVpa          String? @map("upi_vpa")
  upiPayeeName    String? @map("upi_payee_name")
  ptEnabled       Boolean @default(true) @map("pt_enabled") // Professional Tax default for this unit
  updatedAt       DateTime @updatedAt @map("updated_at")

  unit Unit @relation(fields: [unitId], references: [id])

  @@map("unit_settings")
}

model Programme {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique // TODD_CARE | PLAYHOUSE | PREK | K1 | K2
  name        String // fixed — never modify
  tierName    String  @map("tier_name") // Baby Bees, Beginner Bees…
  ageMin      Decimal @map("age_min") @db.Decimal(4, 1)
  ageMax      Decimal @map("age_max") @db.Decimal(4, 1)
  levelColour String  @map("level_colour")
  sortOrder   Int     @default(0) @map("sort_order")

  batches  Batch[]
  students Student[]
  leads    Lead[]
  feeStructures FeeStructure[]

  @@map("programmes")
}

model Batch {
  id           String   @id @default(uuid()) @db.Uuid
  unitId       String   @map("unit_id") @db.Uuid
  programmeId  String   @map("programme_id") @db.Uuid
  name         String // "K1 Morning Gujarati"
  medium       String? // gujarati | english
  shift        String // morning | afternoon | evening
  startTime    String   @map("start_time") // "08:00" — drives attendance lock
  endTime      String?  @map("end_time")
  capacity     Int
  academicYear String   @map("academic_year") // "2026-27"
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  unit      Unit      @relation(fields: [unitId], references: [id])
  programme Programme @relation(fields: [programmeId], references: [id])
  students  Student[]
  attendanceRecords AttendanceRecord[]
  waitlistEntries   WaitlistEntry[]

  @@map("batches")
}

// ─────────────────────────── USERS & AUTH ───────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  role         UserRole
  unitId       String?  @map("unit_id") @db.Uuid // null = HO-level (Founder, AD, Curriculum Lead)
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")

  unit Unit? @relation(fields: [unitId], references: [id])

  auditLogs AuditLog[]
  leadActivities LeadActivity[]

  @@map("users")
}

// ─────────────────────────── LEADS (FIRST BUZZ CRM) ───────────────────────────

model AreaMaster {
  id              String  @id @default(uuid()) @db.Uuid
  locality        String
  pincode         String?
  suggestedUnitId String  @map("suggested_unit_id") @db.Uuid
  isActive        Boolean @default(true) @map("is_active")

  suggestedUnit Unit @relation(fields: [suggestedUnitId], references: [id])

  @@map("area_master")
}

model Lead {
  id                 String         @id @default(uuid()) @db.Uuid
  inquiryNo          String         @unique @map("inquiry_no") // BB-U1-INQ-2627-0001
  stage              LeadStage      @default(NEW_INQUIRY)
  parentName         String         @map("parent_name")
  parentPhone        String         @map("parent_phone")
  parentEmail        String?        @map("parent_email")
  childName          String?        @map("child_name")
  childDob           DateTime?      @map("child_dob") @db.Date
  programmeInterestId String?       @map("programme_interest_id") @db.Uuid
  areaLocality       String?        @map("area_locality")
  preferredUnit      String?        @map("preferred_unit") // U1 | U2 | U3 | NO_PREFERENCE
  suggestedUnitId    String?        @map("suggested_unit_id") @db.Uuid
  assignedUnitId     String?        @map("assigned_unit_id") @db.Uuid
  routingNotes       String?        @map("routing_notes") // mandatory if override
  inquiryChannel     InquiryChannel @default(CALL) @map("inquiry_channel")
  experienceInterest Boolean        @default(false) @map("experience_interest")
  leadScore          Int            @default(0) @map("lead_score")
  sourceCampaign     String?        @map("source_campaign")
  notes              String?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  programmeInterest Programme? @relation(fields: [programmeInterestId], references: [id])
  suggestedUnit     Unit?      @relation("SuggestedUnit", fields: [suggestedUnitId], references: [id])
  assignedUnit      Unit?      @relation("AssignedUnit", fields: [assignedUnitId], references: [id])
  student           Student?
  discoveryFlights  DiscoveryFlight[]
  activities        LeadActivity[]

  @@map("leads")
}

// Timeline of everything that happens on a lead — stage moves, routing,
// notes, registration. Append-only (history is never rewritten).
model LeadActivity {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  type      String // STAGE_CHANGE | ROUTING | NOTE | REGISTRATION | SYSTEM
  note      String?
  meta      Json?
  byId      String?  @map("by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead  @relation(fields: [leadId], references: [id])
  by   User? @relation(fields: [byId], references: [id])

  @@map("lead_activities")
}

// ─────────────────────────── STUDENTS ───────────────────────────

model Student {
  id            String        @id @default(uuid()) @db.Uuid
  unitId        String        @map("unit_id") @db.Uuid
  admissionNo   String        @unique @map("admission_no") // BB-U1-2627-0001
  firstName     String        @map("first_name")
  lastName      String        @map("last_name")
  dob           DateTime      @db.Date
  gender        String?
  photoUrl      String?       @map("photo_url")
  bloodGroup    String?       @map("blood_group") // sensitive — staff only
  allergies     String? // sensitive — staff only
  medicalNotes  String?       @map("medical_notes") // sensitive — staff only
  fatherName    String?       @map("father_name")
  fatherPhone   String?       @map("father_phone")
  motherName    String?       @map("mother_name")
  motherPhone   String?       @map("mother_phone")
  guardianEmail String?       @map("guardian_email") // email fallback channel
  addressArea   String?       @map("address_area")
  programmeId   String?       @map("programme_id") @db.Uuid
  batchId       String?       @map("batch_id") @db.Uuid
  admissionDate DateTime?     @map("admission_date") @db.Date
  orientationDate DateTime?   @map("orientation_date") @db.Date // set at confirmation (spec, module 3)
  anonymisedAt  DateTime?     @map("anonymised_at") // DPDP erasure: PII cleared, finance retained
  instalmentPlan InstalmentPlan? @map("instalment_plan")
  status        StudentStatus @default(ACTIVE)
  academicYear  String        @map("academic_year")
  siblingGroup  String?       @map("sibling_group") // shared key links siblings → concession
  leadId        String?       @unique @map("lead_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  unit      Unit       @relation(fields: [unitId], references: [id])
  programme Programme? @relation(fields: [programmeId], references: [id])
  batch     Batch?     @relation(fields: [batchId], references: [id])
  lead      Lead?      @relation(fields: [leadId], references: [id])

  attendanceRecords AttendanceRecord[]
  leaves            StudentLeave[]
  feeAddons         FeeAddon[]
  feeTransactions   FeeTransaction[]
  discoveryFlights  DiscoveryFlight[]
  messageLogs       MessageLog[]
  certificates      Certificate[]
  parentMessages    ParentMessage[]
  lifecycleRecords  StudentLifecycleRecord[]
  ptmRecords        PtmRecord[]
  eveningEnrollments EveningEnrollment[]
  eveningAttendance  EveningAttendance[]
  waitlistEntries    WaitlistEntry[]
  onlinePayments     OnlinePayment[]
  securityDeposits   SecurityDeposit[]
  documents          StudentDocument[]

  @@map("students")
}

// ─────────────────────────── DISCOVERY FLIGHT ───────────────────────────

// ─────────────────────────── WAITLIST ───────────────────────────

// A full batch must not dead-end the admission conversation at the front desk.
// The child keeps their place in line; the office offers the seat when one frees.
model WaitlistEntry {
  id             String    @id @default(uuid()) @db.Uuid
  unitId         String    @map("unit_id") @db.Uuid
  batchId        String    @map("batch_id") @db.Uuid
  studentId      String?   @map("student_id") @db.Uuid
  childName      String    @map("child_name")
  guardianPhone  String    @map("guardian_phone")
  position       Int
  status         String    @default("WAITING") // WAITING | OFFERED | CONVERTED | DECLINED | EXPIRED
  note           String?
  offeredAt      DateTime? @map("offered_at")
  offerExpiresAt DateTime? @map("offer_expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  unit    Unit     @relation(fields: [unitId], references: [id])
  batch   Batch    @relation(fields: [batchId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])

  @@index([unitId, status, position])
  @@index([batchId, status])
  @@map("waitlist_entries")
}

model DiscoveryFlight {
  id           String           @id @default(uuid()) @db.Uuid
  leadId       String?          @map("lead_id") @db.Uuid
  studentId    String?          @map("student_id") @db.Uuid
  unitId       String           @map("unit_id") @db.Uuid
  scheduledAt  DateTime?        @map("scheduled_at")
  conductedAt  DateTime?        @map("conducted_at")
  resultCode   ScreeningResult? @map("result_code")
  recommendation String? // READY | READY_WITH_SUPPORT | ALTERNATE_LEVEL
  notes        String?
  internalOnly Boolean          @default(true) @map("internal_only") // NEVER parent-visible
  approvedById String?          @map("approved_by_id") @db.Uuid
  approvedAt   DateTime?        @map("approved_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  lead    Lead?    @relation(fields: [leadId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])
  unit    Unit     @relation(fields: [unitId], references: [id])

  @@map("discovery_flights")
}

// ─────────────────────────── ATTENDANCE ───────────────────────────

model AttendanceRecord {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  batchId        String           @map("batch_id") @db.Uuid
  unitId         String           @map("unit_id") @db.Uuid
  date           DateTime         @db.Date
  status         AttendanceStatus @default(ABSENT) // DEFAULT ABSENT — child safety
  markedById     String?          @map("marked_by_id") @db.Uuid
  markedAt       DateTime?        @map("marked_at")
  isLocked       Boolean          @default(false) @map("is_locked")
  lockTime       DateTime?        @map("lock_time") // batch.startTime + 30 min
  overrideById   String?          @map("override_by_id") @db.Uuid // Centre Head only
  overrideReason String?          @map("override_reason")

  student Student @relation(fields: [studentId], references: [id])
  batch   Batch   @relation(fields: [batchId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])

  @@unique([studentId, date, batchId])
  @@map("attendance_records")
}

// Parent- or staff-filed leave. An APPROVED leave is the only thing that
// suppresses the absence alert chain — attendance still defaults to ABSENT.
model StudentLeave {
  id           String    @id @default(uuid()) @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  unitId       String    @map("unit_id") @db.Uuid
  fromDate     DateTime  @map("from_date") @db.Date
  toDate       DateTime  @map("to_date") @db.Date
  type         String    @default("PLANNED") // PLANNED | SICK | FAMILY | OTHER
  reason       String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  source       String    @default("PARENT") // PARENT | STAFF
  appliedById  String?   @map("applied_by_id") @db.Uuid
  decidedById  String?   @map("decided_by_id") @db.Uuid
  decidedAt    DateTime? @map("decided_at")
  decisionNote String?   @map("decision_note")
  createdAt    DateTime  @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])

  @@index([studentId, fromDate])
  @@index([unitId, status, fromDate])
  @@map("student_leaves")
}

// ─────────────────────────── FEES ───────────────────────────

model FeeStructure {
  id              String   @id @default(uuid()) @db.Uuid
  unitId          String   @map("unit_id") @db.Uuid
  programmeId     String   @map("programme_id") @db.Uuid
  academicYear    String   @map("academic_year")
  totalFee        Decimal  @map("total_fee") @db.Decimal(10, 2)
  instalment1     Decimal? @map("instalment_1") @db.Decimal(10, 2)
  instalment2     Decimal? @map("instalment_2") @db.Decimal(10, 2)
  instalment3     Decimal? @map("instalment_3") @db.Decimal(10, 2)
  siblingDiscountPct Decimal? @map("sibling_discount_pct") @db.Decimal(5, 2)
  locked          Boolean  @default(false) // HO locks before AY start
  createdAt       DateTime @default(now()) @map("created_at")

  unit      Unit      @relation(fields: [unitId], references: [id])
  programme Programme @relation(fields: [programmeId], references: [id])

  @@unique([unitId, programmeId, academicYear])
  @@map("fee_structures")
}

model FeeTransaction {
  id            String      @id @default(uuid()) @db.Uuid
  studentId     String      @map("student_id") @db.Uuid
  unitId        String      @map("unit_id") @db.Uuid
  ledgerType    LedgerType  @default(PRESCHOOL) @map("ledger_type") // dual ledger — never merged
  amount        Decimal     @db.Decimal(10, 2)
  discount      Decimal     @default(0) @db.Decimal(10, 2)
  fine          Decimal     @default(0) @db.Decimal(10, 2)
  paymentMode   PaymentMode @map("payment_mode")
  reference     String? // cheque no / UPI ref / razorpay id
  paymentDate   DateTime    @map("payment_date") @db.Date
  instalmentNo  Int?        @map("instalment_no")
  receiptNo     String      @unique @map("receipt_no") // auto, sequential
  remarks       String?
  isCancelled   Boolean     @default(false) @map("is_cancelled")
  collectedById String?     @map("collected_by_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])

  @@map("fee_transactions")
}

// Add-on charges (kit, transport, event fee) are billed separately from the
// annual tuition schedule so the instalment maths stays exact. A settled
// add-on is money received; it never re-allocates tuition instalments.
model FeeAddon {
  id            String      @id @default(uuid()) @db.Uuid
  studentId     String      @map("student_id") @db.Uuid
  unitId        String      @map("unit_id") @db.Uuid
  label         String
  amount        Decimal     @db.Decimal(10, 2)
  ledgerType    LedgerType  @default(PRESCHOOL) @map("ledger_type")
  status        String      @default("PENDING") // PENDING | PAID | WAIVED
  paymentMode   PaymentMode? @map("payment_mode")
  reference     String?
  notes         String?
  billedAt      DateTime    @default(now()) @map("billed_at")
  settledAt     DateTime?   @map("settled_at")
  settledById   String?     @map("settled_by_id") @db.Uuid
  createdById   String?     @map("created_by_id") @db.Uuid

  student Student @relation(fields: [studentId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])

  @@index([unitId, status])
  @@index([studentId, billedAt])
  @@map("fee_addons")
}

// ─────────────────────────── DPDP / AUDIT ───────────────────────────

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tableName String   @map("table_name")
  recordId  String   @map("record_id")
  action    String // INSERT | UPDATE | DELETE
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")
  changedById String? @map("changed_by_id") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at")
  ipAddress String?  @map("ip_address")

  changedBy User? @relation(fields: [changedById], references: [id])

  @@map("audit_log")
}

// Issued certificates — 7 HO-locked templates; TC gated on fee clearance.
model Certificate {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  type       String // BONAFIDE | TC | PROGRESS | PARTICIPATION | GRADUATION | CHARACTER | APPRECIATION
  serialNo   String   @unique @map("serial_no")
  payload    Json?
  issuedById String?  @map("issued_by_id") @db.Uuid
  issuedAt   DateTime @default(now()) @map("issued_at")

  student Student @relation(fields: [studentId], references: [id])

  @@map("certificates")
}

// Outbound message queue — absence alerts, escalations, fee reminders,
// receipts. Status stays QUEUED until the WhatsApp BSP goes live (Slice 7).
model MessageLog {
  id           String    @id @default(uuid()) @db.Uuid
  type         String // ABSENCE_ALERT | ADMIN_CALL | ESCALATION_3DAY | FEE_REMINDER | RECEIPT
  channel      String    @default("WHATSAPP")
  recipient    String // parent phone
  studentId    String?   @map("student_id") @db.Uuid
  unitId       String?   @map("unit_id") @db.Uuid
  payload      Json?
  status       String    @default("QUEUED") // QUEUED | SENT | FAILED | SUPPRESSED
  scheduledFor DateTime? @map("scheduled_for")
  sentAt       DateTime? @map("sent_at")
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  deliveredVia String?   @map("delivered_via") // PUSH | WHATSAPP | EMAIL (+ _SANDBOX)
  templateCode String?   @map("template_code")
  createdAt    DateTime  @default(now()) @map("created_at")

  student Student? @relation(fields: [studentId], references: [id])

  @@map("message_logs")
}

// HO-managed message templates (spec: B2 template management). Wording is
// locked at Head Office; units choose when to send, never what it says.
model MessageTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String
  channel      String   @default("WHATSAPP") // WHATSAPP | EMAIL | INTERNAL
  language     String   @default("en") // en | gu
  body         String
  metaTemplate String?  @map("meta_template") // BSP-approved template name
  approved     Boolean  @default(false)
  active       Boolean  @default(true)
  updatedById  String?  @map("updated_by_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("message_templates")
}

model ConsentLog {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  consentType String   @map("consent_type") // ADMISSION_FORM | PHOTO_VIDEO | DATA_PROCESSING
  granted     Boolean
  grantedBy   String   @map("granted_by") // parent name
  grantedAt   DateTime @default(now()) @map("granted_at")

  @@map("consent_log")
}


// Browser push endpoints are tied to a parent phone, never exposed to staff.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([phone])
  @@map("push_subscriptions")
}

// Parent ↔ Centre Head thread. Parent ownership is enforced through studentId.
model ParentMessage {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  unitId    String   @map("unit_id") @db.Uuid
  sender      String    // PARENT | CENTRE_HEAD
  body        String
  readAt      DateTime? @map("read_at")
  repliedAt   DateTime? @map("replied_at") // set when the CH replies to this thread
  escalatedAt DateTime? @map("escalated_at") // AD escalation after the reply SLA
  createdAt   DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
  @@index([unitId, createdAt])
  @@map("parent_messages")
}

model StudentLifecycleRecord {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  unitId      String   @map("unit_id") @db.Uuid
  tab         String
  title       String
  payload     Json
  visibility  String   @default("STAFF_PARENT") // STAFF_PARENT | STAFF_ONLY | INTERNAL
  status      String?
  eventDate   DateTime? @map("event_date") @db.Date
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  student Student @relation(fields: [studentId], references: [id])
  @@index([studentId, tab])
  @@index([unitId])
  @@map("student_lifecycle_records")
}

model AcademicPlan {
 id String @id @default(uuid()) @db.Uuid
 unitId String? @map("unit_id") @db.Uuid
 programmeId String? @map("programme_id") @db.Uuid
 academicYear String @map("academic_year")
 kind String // YEARLY_GOAL | BIG_ROCK | CALENDAR | LOG_PLAN
 title String
 description String?
 month Int?
 startDate DateTime? @map("start_date") @db.Date
 endDate DateTime? @map("end_date") @db.Date
 status String @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | LOCKED
 parentVisible Boolean @default(false) @map("parent_visible")
 payload Json?
 authoredById String? @map("authored_by_id") @db.Uuid
 approvedById String? @map("approved_by_id") @db.Uuid
 approvedAt DateTime? @map("approved_at")
 // ── HO-locked authoring ──
 // The Academic Director authors a master record and locks it; units consume
 // the locked master and may only add their own overlay (see `masterId`).
 version Int @default(1)
 lockedById String? @map("locked_by_id") @db.Uuid
 lockedAt DateTime? @map("locked_at")
 // A unit overlay points at the AD master it adapts. Self-relation: deleting
 // the master leaves the overlay in place (SET NULL).
 masterId String? @map("master_id") @db.Uuid
 master AcademicPlan? @relation("PlanOverlay", fields: [masterId], references: [id], onDelete: SetNull)
 overlays AcademicPlan[] @relation("PlanOverlay")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@index([academicYear,kind])
 @@index([unitId])
 @@index([masterId])
 @@map("academic_plans")
}

