  preApproved  Boolean  @default(false) @map("pre_approved")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  orders PurchaseOrder[]

  @@index([unitId, active])
  @@map("vendors")
}

model PurchaseRequest {
