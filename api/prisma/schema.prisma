model PurchaseOrder {
  id          String    @id @default(uuid()) @db.Uuid
  unitId      String    @map("unit_id") @db.Uuid
  vendorId    String    @map("vendor_id") @db.Uuid
  requestId   String?   @map("request_id") @db.Uuid
