  joiningDate       DateTime  @map("joining_date") @db.Date
  relievingDate     DateTime? @map("relieving_date") @db.Date
  status            String   @default("ACTIVE") // ACTIVE | ON_NOTICE | RELIEVED | SUSPENDED
  unitId            String   @map("unit_id") @db.Uuid
  department        String?
  designation       String
  reportingManagerId String?  @map("reporting_manager_id") @db.Uuid
  employmentType    String   @map("employment_type") // MORNING_SALARIED | EVENING_HOURLY | DUAL
  bankAccountName   String?  @map("bank_account_name")
  bankAccountNo     String?  @map("bank_account_no")
  bankIfsc          String?  @map("bank_ifsc")
  pan               String?
  uan               String?
  esicNumber        String?  @map("esic_number")
  pfEnabled         Boolean  @default(false) @map("pf_enabled")
  esicEnabled       Boolean  @default(false) @map("esic_enabled")
  ptEnabled         Boolean  @default(false) @map("pt_enabled")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  manager      Employee?  @relation("EmployeeManager", fields: [reportingManagerId], references: [id])
  directReports Employee[] @relation("EmployeeManager")
  history      EmploymentHistory[]
  shifts       EmployeeShift[]
