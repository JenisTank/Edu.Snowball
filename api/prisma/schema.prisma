  eligibleMinutes Int? @map("eligible_minutes")
  createdAt DateTime @default(now()) @map("created_at")
  employee Employee @relation(fields:[employeeId],references:[id])
  @@unique([employeeId,date])
  @@map("overtime_authorisations")
}

model PayrollRun {
  id String @id @default(uuid()) @db.Uuid
  type String
  month String
  unitId String? @map("unit_id") @db.Uuid
  status String @default("DRAFT")
  version Int @default(1)
  createdById String @map("created_by_id") @db.Uuid
  submittedById String? @map("submitted_by_id") @db.Uuid
  approvedById String? @map("approved_by_id") @db.Uuid
  approvedAt DateTime? @map("approved_at")
  lockedAt DateTime? @map("locked_at")
  reversalOfId String? @map("reversal_of_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  lines PayrollLine[]
  @@unique([type,month,unitId,version])
  @@map("payroll_runs")
}

model PayrollLine {
  id String @id @default(uuid()) @db.Uuid
  runId String @map("run_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  gross Decimal @db.Decimal(12,2)
  deductions Decimal @db.Decimal(12,2)
  employerContributions Decimal @default(0) @map("employer_contributions") @db.Decimal(12,2)
  net Decimal @db.Decimal(12,2)
  workedMinutes Int @default(0) @map("worked_minutes")
  otMinutes Int @default(0) @map("ot_minutes")
  lwpDays Decimal @default(0) @map("lwp_days") @db.Decimal(6,2)
  details Json
  run PayrollRun @relation(fields:[runId],references:[id])
  employee Employee @relation(fields:[employeeId],references:[id])
  @@unique([runId,employeeId])
  @@map("payroll_lines")
}

model PayrollAdjustment {
  id String @id @default(uuid()) @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  month String
  type String
  amount Decimal @db.Decimal(12,2)
  reason String
  status String @default("APPROVED")
  sourceRunId String? @map("source_run_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  employee Employee @relation(fields:[employeeId],references:[id])
  @@index([employeeId,month])
  @@map("payroll_adjustments")
}

model EmployeeMinuteRate {
  id String @id @default(uuid()) @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  rate Decimal @db.Decimal(10,4)
  effectiveFrom DateTime @map("effective_from") @db.Date
  effectiveTo DateTime? @map("effective_to") @db.Date
  employee Employee @relation(fields:[employeeId],references:[id])
  @@index([employeeId,effectiveFrom])
  @@map("employee_minute_rates")
}

model StatutoryScheme {
  id String @id @default(uuid()) @db.Uuid
  code String
  name String
  effectiveFrom DateTime @map("effective_from") @db.Date
  effectiveTo DateTime? @map("effective_to") @db.Date
  employeeRate Decimal @map("employee_rate") @db.Decimal(7,4)
  employerRate Decimal @default(0) @map("employer_rate") @db.Decimal(7,4)
  wageCeiling Decimal? @map("wage_ceiling") @db.Decimal(12,2)
  calculationBasis String @map("calculation_basis")
  active Boolean @default(true)
  slabs StatutorySlab[]
  @@index([code,effectiveFrom])
  @@map("statutory_schemes")
}

model StatutorySlab {
  id String @id @default(uuid()) @db.Uuid
  schemeId String @map("scheme_id") @db.Uuid
  minAmount Decimal @map("min_amount") @db.Decimal(12,2)
  maxAmount Decimal? @map("max_amount") @db.Decimal(12,2)
  deduction Decimal @db.Decimal(12,2)
  scheme StatutoryScheme @relation(fields:[schemeId],references:[id])
  @@map("statutory_slabs")
}

// ─────────────────────── FRONT DESK ───────────────────────

// A security deposit is money the centre holds, not income: it sits as a
// liability until it is returned or forfeited, and both endings need a reason.
model SecurityDeposit {
  id          String    @id @default(uuid()) @db.Uuid
  unitId      String    @map("unit_id") @db.Uuid
  employeeId  String?   @map("employee_id") @db.Uuid
  studentId   String?   @map("student_id") @db.Uuid
  amount      Decimal   @db.Decimal(10, 2)
  status      String    @default("HELD") // HELD | RETURNED | FORFEITED
  collectedAt DateTime  @default(now()) @map("collected_at")
  closedAt    DateTime? @map("closed_at")
  reason      String? // why it was returned or forfeited
  notes       String?
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  unit     Unit      @relation(fields: [unitId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  student  Student?  @relation(fields: [studentId], references: [id])

  @@index([unitId, status])
  @@index([employeeId])
  @@index([studentId])
  @@map("security_deposits")
}

// Reception's visitor book. The gate log is a safety record: who is in the
// building, on whose authority, and when they left.
model GuestLog {
  id           String    @id @default(uuid()) @db.Uuid
  unitId       String    @map("unit_id") @db.Uuid
  guestName    String    @map("guest_name")
  phone        String?
  organisation String?
  purpose      String // PARENT_VISIT | ADMISSION_ENQUIRY | VENDOR | INTERVIEW | OFFICIAL | OTHER
  hostName     String?   @map("host_name")
  badgeNo      String?   @map("badge_no")
  studentId    String?   @map("student_id") @db.Uuid
  inAt         DateTime  @default(now()) @map("in_at")
  outAt        DateTime? @map("out_at")
  notes        String?
  createdById  String?   @map("created_by_id") @db.Uuid

  unit Unit @relation(fields: [unitId], references: [id])

  @@index([unitId, inAt])
  @@map("guest_logs")
}

// ─────────────────────── DOCUMENT STORE ───────────────────────

// Per-student files (birth certificate, medical note, signed PTM form…).
// Deletion is manual and audited — the retention job never touches these.
model StudentDocument {
  id          String    @id @default(uuid()) @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  unitId      String    @map("unit_id") @db.Uuid
  kind        String    @default("OTHER") // BIRTH_CERT | AADHAAR | PHOTO | MEDICAL | REPORT_CARD | PTM_FORM | OTHER
  fileName    String    @map("file_name")
  mimeType    String    @map("mime_type")
  sizeBytes   Int       @map("size_bytes")
  storageKey  String    @unique @map("storage_key")
  driver      String    @default("LOCAL") // LOCAL | S3
  notes       String?
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id") @db.Uuid

  student Student @relation(fields: [studentId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])

  @@index([studentId, kind])
  @@index([unitId, createdAt])
  @@map("student_documents")
}

// ─────────────────────── INVENTORY ───────────────────────

// One row per item that dropped to (or below) its reorder level. Raised by the
// daily tick and by every stock movement, so the alert exists the moment the
// shelf is low rather than whenever someone opens a report.
model ReorderAlert {
  id           String    @id @default(uuid()) @db.Uuid
  itemId       String    @map("item_id") @db.Uuid
  unitId       String?   @map("unit_id") @db.Uuid
  quantity     Int
  reorderLevel Int       @map("reorder_level")
  status       String    @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED
  note         String?
  raisedAt     DateTime  @default(now()) @map("raised_at")
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id") @db.Uuid

  item InventoryItem @relation(fields: [itemId], references: [id])

  @@index([status, raisedAt])
  @@index([itemId, status])
  @@map("reorder_alerts")
}

model AppSetting {
  key String @id
  value Json
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("app_settings")
}

