# ─────────────────────────────────────────────────────────────
# BumbleB Kidz ERP — environment template
# Copy to `.env` at the repository root:  cp .env.example .env
# Docker Compose reads it automatically; the API reads it when
# started from the `api/` folder (copy it there for local dev).
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL ───────────────────────────────────────────────
# Local dev (scripts/dev-restore.sh creates this role/database)
DATABASE_URL=postgresql://bumbleb:bumbleb_dev@localhost:5432/bumblebkidz_erp
# Docker Compose builds DATABASE_URL from these two values
DB_PASSWORD=change_me_in_production

# ── Redis (BullMQ queues: attendance locks, reminders, absence scans) ──
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────
# REQUIRED. Use 32+ random characters in production:
#   openssl rand -base64 48
JWT_SECRET=dev-only-change-me-to-32-random-characters
# Spec: 15-minute access token, 7-day refresh token
JWT_EXPIRES=15m

# ── WhatsApp Business API (BSP) ──────────────────────────────
# Leave blank to keep the comms outbox in SANDBOX mode
# (messages are logged and marked SENT without leaving the server).
WA_BSP_KEY=

# ── Parent PWA web push ──────────────────────────────────────
# Generate once per deployment:  npx web-push generate-vapid-keys
# Push stays disabled (and the portal keeps working) when these are empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bumblebkidz.com
