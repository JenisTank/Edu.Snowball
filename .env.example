# ─────────────────────────────────────────────────────────────────────
# BumbleB Kidz ERP — copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env && nano .env
# ─────────────────────────────────────────────────────────────────────

# ── Core (required) ──
DB_PASSWORD=change_me_strong_password
JWT_SECRET=change_me_64_random_chars        # openssl rand -hex 32
# Host port the VPS reverse proxy forwards the domain to. Change it if
# another project on this server already uses 8080.
BB_HTTP_PORT=8080

# Used only when running the API outside Docker (local development):
# DATABASE_URL=postgresql://bumbleb:password@localhost:5432/bumblebkidz_erp
# REDIS_URL=redis://localhost:6379
PORT=3000

# ── DPDP: encryption of sensitive student data at rest (required in prod) ──
# 32-byte key, hex or base64:  openssl rand -hex 32
# Changing this key makes existing encrypted values unreadable — back it up.
PII_ENCRYPTION_KEY=

# ── Document vault ──
STORAGE_DIR=/app/storage
MAX_UPLOAD_MB=10

# ── Payments (placeholder mode while merchant KYC is pending) ──
# With no Razorpay keys the app stays in placeholder mode: parents get a UPI
# QR/intent and the office confirms the reference. Add the keys to go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPI_VPA=bumblebkidz@okicici
UPI_PAYEE_NAME=BumbleB Kidz

# ── Web push to the parent PWA ──
# Generate once:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@bumblebkidz.com

# ── WhatsApp BSP (connect later — leave blank to stay in sandbox) ──
WA_BSP_KEY=
WA_BSP_URL=

# ── Email fallback (optional) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BumbleB Kidz <no-reply@bumblebkidz.com>"
