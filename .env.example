# ─────────────────────────────────────────────────────────────
# BumbleB Kidz ERP — environment template
# Copy to `.env` at the repository root:  cp .env.example .env
# Docker Compose reads it automatically; the API reads it when
# started from the `api/` folder (copy it there for local dev).
# ─────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL ───────────────────────────────────────────────
# Local dev (scripts/dev-restore.sh creates this role/database)
DATABASE_URL=postgresql://bumbleb:bumbleb_dev@localhost:5432/bumblebkidz_erp
# Docker Compose builds DATABASE_URL from these two values
DB_PASSWORD=change_me_in_production

# ── Redis (BullMQ queues: attendance locks, reminders, absence scans) ──
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────
# REQUIRED. Use 32+ random characters in production:
#   openssl rand -base64 48
JWT_SECRET=dev-only-change-me-to-32-random-characters
# Spec: 15-minute access token, 7-day refresh token
JWT_EXPIRES=15m

# ── WhatsApp (Evolution API — default transport) ─────────────
# Self-hosted Evolution API v2 with one instance linked to the centre's number.
# Leave blank to keep the comms outbox in SANDBOX mode (messages are logged and
# marked SENT without leaving the server).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Meta Cloud API stays supported if a BSP is signed later; it is used only when
# the three Evolution variables above are empty.
WA_BSP_KEY=
WA_PHONE_ID=

# ── DPDP encryption (PII at rest) ────────────────────────────
# Required in production: encrypts PAN/UAN/bank details. 32+ chars.
#   openssl rand -hex 32
# Without it the API only WARNS and stores statutory PII in plaintext.
PII_KEY=
# Retention windows (days) for the nightly purge.
RETENTION_MESSAGE_DAYS=730
RETENTION_AUDIT_DAYS=2555

# ── Email fallback (only used when WhatsApp is unavailable) ──
SMTP_URL=
MAIL_FROM=BumbleB Kidz <no-reply@bumblebkidz.com>

# ── Parent PWA web push ──────────────────────────────────────
# Generate once per deployment:  npx web-push generate-vapid-keys
# Push stays disabled (and the portal keeps working) when these are empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bumblebkidz.com

# ── Online fee payment (UPI QR — no gateway) ─────────────────
# There is no merchant account and no KYC. Each centre publishes its own UPI id
# in Settings → Units; the parent app builds a upi:// link for the exact amount
# and the front desk confirms the credit against the bank statement.
# Head Office can set a fallback VPA used by units that have none:
UPI_VPA=
UPI_PAYEE_NAME=
# ── Student document storage ─────────────────────────────────
# LOCAL writes under STORAGE_DIR; S3 switches to any S3-compatible bucket.
STORAGE_DRIVER=local
STORAGE_DIR=./var/documents
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=ap-south-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# ── Monitoring ───────────────────────────────────────────────
# Sentry is a no-op until a DSN is set. 0 disables tracing.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Shown next to every error; use the git sha or image tag in production
APP_RELEASE=
